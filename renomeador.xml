<launch4jConfig>

    <headerType>gui</headerType>

    <jar>renomeador.jar</jar>

    <outfile>RenomeadorArquivos.exe</outfile>

    <chdir>.</chdir>

    <priority>normal</priority>

    <stayAlive>false</stayAlive>

    <classPath>
        <mainClass>br.com.innove.Main</mainClass>
        <cp>renomeador.jar</cp>
        <cp>libs/pdfbox-app-3.0.2.jar</cp>
        <cp>libs/commons-logging-1.2.jar</cp>
        <cp>libs/fontbox-2.0.35.jar</cp>
        <cp>libs/xmpbox-2.0.35.jar</cp>
    </classPath>

    <jre>
        <minVersion>1.8.0</minVersion>
        <maxVersion>1.8.999</maxVersion>
        <jdkPreference>preferJre</jdkPreference>
    </jre>

    <icon>icon/renomeador.ico</icon>

</launch4jConfig>